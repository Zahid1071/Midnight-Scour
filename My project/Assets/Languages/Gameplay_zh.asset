    m_Metadata:
      m_Items: []
  - m_Id: 103287948525158
    m_Localized: "提示：利用藏身点躲避敌人。"
    m_Metadata:
      m_Items: []
  - m_Id: 851272291309295
    m_Localized: "提示：仔细探索，可能发现重要线索。"
    m_Metadata:
      m_Items: []
  - m_Id: 201926414634091
    m_Localized: "提示：保持安静，敌人会听到你。"
    m_Metadata:
      m_Items: []
  - m_Id: 604982533353802
    m_Localized: "提示：手电筒电量有限，请谨慎使用。"
    m_Metadata:
      m_Items: []
  - m_Id: 103287948611352
    m_Localized: "提示：有些门需要特殊钥匙。"
    m_Metadata:
      m_Items: []
  - m_Id: 100106062865639
    m_Localized: "提示：奔跑可能引起敌人注意。"
    m_Metadata:
      m_Items: []
  - m_Id: 201926410015261
    m_Localized: "提示：阅读笔记和文件以了解剧情。"
    m_Metadata:
      m_Items: []
  - m_Id: 103287948398746
    m_Localized: "提示：躲在暗处有助于隐蔽。"
