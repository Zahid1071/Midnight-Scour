    m_Metadata:
      m_Items: []
  - m_Id: 196689379907868
    m_Localized: "需要 {item}。"
    m_Metadata:
      m_Items: []
  - m_Id: 746496736312203
    m_Localized: "此槽位未配置。"
    m_Metadata:
      m_Items: []
  - m_Id: 822985230101255
    m_Localized: "{item} 已安装。"
    m_Metadata:
      m_Items: []
  - m_Id: 248276586766930
    m_Localized: "请先从背包选择汽车零件。"
    m_Metadata:
      m_Items: []
