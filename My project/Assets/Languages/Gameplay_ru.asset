  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 191681225664082
    m_Localized: "Подождите немного."
    m_Metadata:
      m_Items: []
  - m_Id: 775374556467803
    m_Localized: "Вы уже прячетесь."
    m_Metadata:
      m_Items: []
  - m_Id: 957259476134756
    m_Localized: "Нельзя использовать здесь."
    m_Metadata:
      m_Items: []
  - m_Id: 535720050874891
    m_Localized: "Ничего в зоне досягаемости."
    m_Metadata:
      m_Items: []
  - m_Id: 323125971988007
    m_Localized: "Нельзя выбросить этот предмет."
    m_Metadata:
      m_Items: []
  - m_Id: 418810216866866
    m_Localized: "Выброшено: {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 658091193514898
    m_Localized: "Инвентарь полон."
    m_Metadata:
      m_Items: []
  - m_Id: 376259017358712
    m_Localized: "Подобрано: {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 536023578518095
    m_Localized: "Нечего положить на хранение."
    m_Metadata:
      m_Items: []
  - m_Id: 686622359119908
    m_Localized: "Сохранено: {names}."
    m_Metadata:
      m_Items: []
  - m_Id: 152585157520631
    m_Localized: "Взаимодействие не настроено."
    m_Metadata:
      m_Items: []
  - m_Id: 648086864232191
    m_Localized: "Использовано: {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 196689379907868
    m_Localized: "Нужно: {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 746496736312203
    m_Localized: "Слот не настроен."
    m_Metadata:
      m_Items: []
  - m_Id: 822985230101255
    m_Localized: "{item} уже установлена."
    m_Metadata:
      m_Items: []
  - m_Id: 248276586766930
    m_Localized: "Сначала выберите деталь в инвентаре."
    m_Metadata:
      m_Items: []
  - m_Id: 778497760464299
    m_Localized: "{selected} не подходит. Нужно: {required}."
    m_Metadata:
      m_Items: []
  - m_Id: 837956236827754
    m_Localized: "У вас нет {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 423834490733102
    m_Localized: "Установлено: {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 249022359268307
    m_Localized: "Побег не настроен."
    m_Metadata:
      m_Items: []
  - m_Id: 467151235288966
    m_Localized: "Все детали установлены. Вы сбежали!"
    m_Metadata:
      m_Items: []
  - m_Id: 475193675483248
    m_Localized: "Не хватает: {list}."
    m_Metadata:
      m_Items: []
  - m_Id: 495521611443387
    m_Localized: "Дверь заперта."
    m_Metadata:
      m_Items: []
  - m_Id: 899966540740152
    m_Localized: "Этот предмет нельзя использовать здесь."
    m_Metadata:
      m_Items: []
  - m_Id: 106318970123188
    m_Localized: "У вас нет этого предмета."
    m_Metadata:
      m_Items: []
  - m_Id: 432872100951902
    m_Localized: "{item} открыл замок."
    m_Metadata:
      m_Items: []
  - m_Id: 103287948525158
    m_Localized: "СОВЕТ: Используйте укрытия, чтобы спрятаться от врагов."
    m_Metadata:
      m_Items: []
  - m_Id: 851272291309295
    m_Localized: "СОВЕТ: Исследуйте внимательно — можно найти важные подсказки."
    m_Metadata:
      m_Items: []
  - m_Id: 201926414634091
    m_Localized: "СОВЕТ: Будьте тихи — враги вас услышат."
    m_Metadata:
      m_Items: []
  - m_Id: 604982533353802
    m_Localized: "СОВЕТ: У фонарика ограничен заряд — берегите батарею."
    m_Metadata:
      m_Items: []
  - m_Id: 103287948611352
    m_Localized: "СОВЕТ: Некоторые двери требуют особых ключей."
    m_Metadata:
      m_Items: []
  - m_Id: 100106062865639
    m_Localized: "СОВЕТ: Бег может привлечь врагов."
    m_Metadata:
      m_Items: []
  - m_Id: 201926410015261
    m_Localized: "СОВЕТ: Читайте записки и документы, чтобы узнать историю."
    m_Metadata:
      m_Items: []
  - m_Id: 103287948398746
    m_Localized: "СОВЕТ: Тёмные углы помогают оставаться незамеченным."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
