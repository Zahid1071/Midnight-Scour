  m_TableData:
  - m_Id: 191681225664082
    m_Localized: "Einen Moment warten."
    m_Metadata:
      m_Items: []
  - m_Id: 775374556467803
    m_Localized: "Du versteckst dich bereits."
    m_Metadata:
      m_Items: []
  - m_Id: 957259476134756
    m_Localized: "Das kann hier nicht benutzt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 535720050874891
    m_Localized: "Nichts in Reichweite."
    m_Metadata:
      m_Items: []
  - m_Id: 323125971988007
    m_Localized: "Dieser Gegenstand kann nicht abgelegt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 418810216866866
    m_Localized: "{item} abgelegt."
    m_Metadata:
      m_Items: []
  - m_Id: 658091193514898
    m_Localized: "Inventar ist voll."
    m_Metadata:
      m_Items: []
  - m_Id: 376259017358712
    m_Localized: "{item} aufgenommen."
    m_Metadata:
      m_Items: []
  - m_Id: 536023578518095
    m_Localized: "Nichts zum Einlagern."
    m_Metadata:
      m_Items: []
  - m_Id: 686622359119908
    m_Localized: "Eingelagert: {names}."
    m_Metadata:
      m_Items: []
  - m_Id: 152585157520631
    m_Localized: "Interaktion nicht konfiguriert."
    m_Metadata:
      m_Items: []
  - m_Id: 648086864232191
    m_Localized: "{item} wurde benutzt."
    m_Metadata:
      m_Items: []
  - m_Id: 196689379907868
    m_Localized: "Du brauchst {item}."
    m_Metadata:
      m_Items: []
  - m_Id: 746496736312203
    m_Localized: "Slot nicht konfiguriert."
    m_Metadata:
      m_Items: []
  - m_Id: 822985230101255
    m_Localized: "{item} ist bereits eingebaut."
    m_Metadata:
      m_Items: []
  - m_Id: 248276586766930
    m_Localized: "Wähle zuerst ein Autoteil im Inventar."
    m_Metadata:
      m_Items: []
  - m_Id: 778497760464299
    m_Localized: "{selected} passt nicht. Du brauchst {required}."
    m_Metadata:
      m_Items: []
  - m_Id: 837956236827754
    m_Localized: "Du hast {item} nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 423834490733102
    m_Localized: "{item} eingebaut."
    m_Metadata:
      m_Items: []
  - m_Id: 249022359268307
    m_Localized: "Fluchtsequenz nicht eingerichtet."
    m_Metadata:
      m_Items: []
  - m_Id: 467151235288966
    m_Localized: "Alle Teile eingebaut. Du bist entkommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 475193675483248
    m_Localized: "Fehlt noch: {list}."
    m_Metadata:
      m_Items: []
  - m_Id: 495521611443387
    m_Localized: "Die Tür ist verschlossen."
    m_Metadata:
      m_Items: []
  - m_Id: 899966540740152
    m_Localized: "Dieser Gegenstand kann hier nicht benutzt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 106318970123188
    m_Localized: "Du hast diesen Gegenstand nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 432872100951902
    m_Localized: "{item} hat es geöffnet."
    m_Metadata:
      m_Items: []
  - m_Id: 103287948525158
    m_Localized: "TIPP: Nutze Verstecke, um Feinden zu entkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 851272291309295
    m_Localized: "TIPP: Erkunde gründlich — wichtige Hinweise warten."
    m_Metadata:
      m_Items: []
  - m_Id: 201926414634091
    m_Localized: "TIPP: Sei leise — Feinde hören dich."
    m_Metadata:
      m_Items: []
  - m_Id: 604982533353802
    m_Localized: "TIPP: Die Taschenlampe hat begrenzte Batterie."
    m_Metadata:
      m_Items: []
  - m_Id: 103287948611352
    m_Localized: "TIPP: Manche Türen brauchen besondere Schlüssel."
    m_Metadata:
      m_Items: []
  - m_Id: 100106062865639
    m_Localized: "TIPP: Rennen kann Feinde aufmerksam machen."
    m_Metadata:
      m_Items: []
  - m_Id: 201926410015261
    m_Localized: "TIPP: Lies Notizen und Dokumente für die Geschichte."
    m_Metadata:
      m_Items: []
  - m_Id: 103287948398746
    m_Localized: "TIPP: Dunkle Ecken helfen beim Verstecken."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
