  m_TableData:
  - m_Id: 5707297325056
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325057
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325058
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325059
    m_Localized: Uygula
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325060
    m_Localized: "Varsay\u0131lan"
    m_Metadata:
      m_Items: []
  - m_Id: 1843970048000
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325061
    m_Localized: Yeni Oyun
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325062
    m_Localized: Jenerik
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325063
    m_Localized: Oyunu Kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325064
    m_Localized: DURAKLATILDI
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296576
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296577
    m_Localized: "Midnight Scour oynad\u0131\u011F\u0131n\u0131z i\xE7in te\u015Fekk\xFCrler"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296578
    m_Localized: "\xE7\u0131kmak i\xE7in esc tu\u015Funa bas\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296579
    m_Localized: "devam etmek i\xE7in herhangi bir tu\u015Fa bas\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296580
    m_Localized: "\u0130pu\xE7lar\u0131 i\xE7in notlar\u0131 okuyabilirsiniz"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296581
    m_Localized: "Katilden ka\xE7\u0131nmak i\xE7in saklanma noktalar\u0131n\u0131
      kullan\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296582
    m_Localized: "G\xFCr\xFClt\xFC yapmak katili uyarabilir"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296583
    m_Localized: "F\u0131rlatmak i\xE7in {0} tu\u015Funa bas, yere koymak i\xE7in
      bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296584
    m_Localized: "\xD6\u011Feyi Kullan/Birle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296585
    m_Localized: "Etkile\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296586
    m_Localized: AYARLAR
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296587
    m_Localized: "G\xF6r\xFCnt\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296588
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296589
    m_Localized: Kontroller
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296590
    m_Localized: "Oynan\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296591
    m_Localized: Genel
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296592
    m_Localized: Ana Ses
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296593
    m_Localized: "M\xFCzik Sesi"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296594
    m_Localized: Efekt Sesi
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296595
    m_Localized: "Parlakl\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296596
    m_Localized: Fare Hassasiyeti
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296800
    m_Localized: Mikrofon Hassasiyeti
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296597
    m_Localized: "\xC7\xF6z\xFCn\xFCrl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296598
    m_Localized: Tam Ekran
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296599
    m_Localized: "G\xF6r\xFCnt\xFC Modu"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296600
    m_Localized: Kalite
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296601
    m_Localized: Dikey Senkron
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296602
    m_Localized: "Otomatik Kay\u0131t"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296603
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "Bu burada i\u015Fe yaramaz."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: Kilitli.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "\xC7ok uzak."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "K\u0131p\u0131rdam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Bir dakika bekle.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Zaten saklan\u0131yorsun."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: '{0} gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "{0} kullan\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} kilidi a\xE7t\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: "C\u0131vata \xE7\u0131kar\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "S\u0131k\u0131\u015Fm\u0131\u015F durumda."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Bu etkile\u015Fim yap\u0131land\u0131r\u0131lmam\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "Saklayacak bir \u015Feyin yok."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "Sakland\u0131: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} zaten tak\u0131l\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "\xD6nce envanterinden bir araba par\xE7as\u0131 se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: '{0} yok senin.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "{0} tak\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Bu yuva yap\u0131land\u0131r\u0131lmam\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "Ka\xE7\u0131\u015F dizisi ayarlanmam\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "T\xFCm par\xE7alar tak\u0131ld\u0131. Ka\xE7t\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "H\xE2l\xE2 eksik: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: "Y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296630
    m_Localized: Demir Kol
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296631
    m_Localized: Kemik
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296632
    m_Localized: Kemik
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296633
    m_Localized: "Bodrum Anahtar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296634
    m_Localized: "Metal Kutu Anahtar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296635
    m_Localized: "Sak\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296636
    m_Localized: Debriyaj
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296637
    m_Localized: "\xC7eki\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296638
    m_Localized: Pompa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296639
    m_Localized: Tornavida
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296640
    m_Localized: Buji
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296641
    m_Localized: Vazo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296642
    m_Localized: "\u0130ngiliz Anahtar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296643
    m_Localized: "Demir Kol al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296644
    m_Localized: Kemik envantere eklendi
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296645
    m_Localized: "Sak\u0131zl\u0131 Kemik envantere eklendi"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296646
    m_Localized: "Anahtar al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296647
    m_Localized: "K\xFC\xE7\xFCk anahtar al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296648
    m_Localized: "Sak\u0131z al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296649
    m_Localized: "\xC7eki\xE7 al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296650
    m_Localized: "Pompa al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: "Tornavida al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: "\u0130\xE7inde bir \u015Fey var"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: "\u0130ngiliz Anahtar\u0131 al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "Tamamen t\u0131kanm\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: "Su zaten gitmi\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: "Bunu d\xF6nd\xFCrmek i\xE7in kol eksik."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: Kolu mengeneye kullan.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: "\xC7ekici kolun \xFCzerinde kullan."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "Sak\u0131z\u0131 kemi\u011Fe yap\u0131\u015Ft\u0131rd\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: "S\xFCrekli kay\u0131yor, kemi\u011Fe bir \u015Fey yap\u0131\u015Ft\u0131rmam
      gerekiyor"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "Tornavida k\u0131r\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: "\u0130PUCU: Saklanma noktalar\u0131n\u0131 kullanarak d\xFC\u015Fmanlardan
      ka\xE7abilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "\u0130PUCU: Etraf\u0131 dikkatli ara\u015Ft\u0131r\u0131n, \xF6nemli
      ipu\xE7lar\u0131 bulabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: "\u0130PUCU: Sesinizi k\u0131s\u0131k tutun, d\xFC\u015Fmanlar sizi
      duyabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "\u0130PUCU: El feneriniz s\u0131n\u0131rl\u0131 pile sahip, dikkatli
      kullan\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: "\u0130PUCU: Baz\u0131 kap\u0131lar \xF6zel anahtarlar gerektirir."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "\u0130PUCU: Ko\u015Fmak d\xFC\u015Fmanlar\u0131n dikkatini \xE7ekebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: "\u0130PUCU: Notlar\u0131 ve d\xF6k\xFCmanlar\u0131 okuyarak hikayeyi
      ke\u015Ffedin."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: "\u0130PUCU: Karanl\u0131k k\xF6\u015Felerde saklanmak d\xFC\u015Fmanlardan
      korunman\u0131za yard\u0131mc\u0131 olur."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: "Burada bir \u015Fey yok."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: Envanterin dolu.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: "Izgara h\xE2l\xE2 civatal\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: Onay
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "Oyundan \xE7\u0131kmak istedi\u011Finize emin misiniz?\nKaydedilmemi\u015F
      ilerleme kaybolacak."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: "\xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "Ana men\xFCye d\xF6nmek istedi\u011Finize emin misiniz?\nKaydedilmemi\u015F
      ilerleme kaybolacak."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296680
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296681
    m_Localized: "D\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296682
    m_Localized: "San\u0131r\u0131m o vazonun i\xE7inde bir \u015Fey vard\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296683
    m_Localized: "{0} b\u0131rak\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296684
    m_Localized: Etkin
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296685
    m_Localized: "Devre D\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296686
    m_Localized: Tam Ekran
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296687
    m_Localized: Pencere
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296688
    m_Localized: "Kenarl\u0131kl\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296689
    m_Localized: "\xD6zel Tam Ekran"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296690
    m_Localized: "\xC7ok D\xFC\u015F\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296691
    m_Localized: "D\xFC\u015F\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296692
    m_Localized: Orta
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296693
    m_Localized: "Y\xFCksek"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296694
    m_Localized: "\xC7ok Y\xFCksek"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296695
    m_Localized: Ultra
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296696
    m_Localized: "\xD6\u011Feyi Kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296697
    m_Localized: "B\u0131rak"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296698
    m_Localized: "Eri\u015Febilece\u011Fim bir \u015Fey yok."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296699
    m_Localized: "Tuvalet t\u0131kal\u0131, pompay\u0131 bulam\u0131yorum. Bir kovan\u0131n
      i\xE7inde bir yerdeydi ama yerini hat\u0131rlam\u0131yorum."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296701
    m_Localized: "Debriyaj al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296700
    m_Localized: "Buji al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296702
    m_Localized: E
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296703
    m_Localized: G
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296704
    m_Localized: "D\xF6nd\xFCrmek i\xE7in bir \u015Feyle vurmam gerekiyor gibi, tamamen
      paslanm\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296705
    m_Localized: "Kilit kolayca k\u0131r\u0131labilir gibi g\xF6r\xFCn\xFCyor."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296706
    m_Localized: "\xC7\xF6mel"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296707
    m_Localized: "Ko\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296708
    m_Localized: Ctrl
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296709
    m_Localized: Shift
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296710
    m_Localized: "Yolu t\u0131k\u0131yorum."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296711
    m_Localized: "Bu deneyimi nas\u0131l puanlars\u0131n\u0131z?"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296712
    m_Localized: Gerilim
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296713
    m_Localized: Korku
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296714
    m_Localized: "E\u011Flence"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296715
    m_Localized: "*iste\u011Fe ba\u011Fl\u0131* geri bildirim alan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296716
    m_Localized: "G\xF6nder"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296717
    m_Localized: "Merhaba \u2014 Tam oyun i\xE7in b\xFCt\xE7eyi ve kapsam\u0131 b\xFCy\xFCtmek
      istiyoruz; geri bildiriminiz ilerlememiz i\xE7in en \xF6nemli rehber."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296718
    m_Localized: '?'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296719
    m_Localized: "G\xF6nderiliyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296720
    m_Localized: "G\xF6nderildi"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296721
    m_Localized: Tekrar dene
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296722
    m_Localized: Hepsini puanla
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296723
    m_Localized: Kurulum gerekli
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296724
    m_Localized: "\u0130stek Listesine Ekle!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296725
    m_Localized: "\xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296726
    m_Localized: "Zaten yapt\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296727
    m_Localized: "G\xFCncellendi"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296728
    m_Localized: "Katil tekrar eden hareketlerinizi fark edecek ve uyum sa\u011Flayacak."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296729
    m_Localized: "Ba\u015Fard\u0131m, m\xFCkemmel zamanlama"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296730
    m_Localized: "\xC7eki\xE7 darbesinin sesini, g\xF6kg\xFCr\xFClt\xFCs\xFCne denk
      getirebilirim"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296731
    m_Localized: "Bu \xE7ok ses \xE7\u0131kar\u0131r, \u015Fimdi vuramam"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296732
    m_Localized: "\xC7ok ge\xE7 vurdum, yakalayacak"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296733
    m_Localized: "Kilidi zorlamak i\xE7in tornaviday\u0131 sok."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296734
    m_Localized: "Tornavida tak\u0131lana kadar hareket ettir."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296735
    m_Localized: "\xC7ok erken vurdum, yakalanaca\u011F\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296736
    m_Localized: "\xC7ok ge\xE7 vurdum, yakalanaca\u011F\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296737
    m_Localized: "S\u0131k\u0131\u015Ft\u0131, tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296738
    m_Localized: "Butcher sakland\u0131\u011F\u0131n\u0131 g\xF6rd\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296739
    m_Localized: "\xC7ok fazla ses \xE7\u0131kard\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296740
    m_Localized: "Ayn\u0131 saklanma yerini tekrar tekrar kulland\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296741
    m_Localized: "\xC7eki\xE7 sesini g\xF6kg\xFCr\xFClt\xFCs\xFCyle gizleyemedin."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296742
    m_Localized: "Butcher seni g\xF6rd\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296743
    m_Localized: "Yakaland\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296744
    m_Localized: "Yeniden Ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296745
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296746
    m_Localized: Butcher sana pusu kurdu.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296747
    m_Localized: "Maymuncuklar yakaland\u0131ktan sonra ilerlemeni koruman\u0131
      sa\u011Flar."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296748
    m_Localized: Maymuncuk
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296749
    m_Localized: "Maymuncuk al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296750
    m_Localized: Devam
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296751
    m_Localized: "Bas\u0131n\xE7 uygulamak i\xE7in sa\u011F t\u0131k bas\u0131l\u0131
      tut"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296752
    m_Localized: "Fareyi kullanarak maymuncu\u011Fu ileri geri hareket ettir ve s\u0131rayla
      pinleri bul"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296753
    m_Localized: Pin sabitlendi
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296754
    m_Localized: "Kilit a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296755
    m_Localized: "Kap\u0131 zincirle kilitli."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296756
    m_Localized: "\u0130lk yakaland\u0131\u011F\u0131mda kap\u0131y\u0131 asma kilitli
      bir zincirle ba\u011Flad\u0131. Ke\u015Fke o tuvaletin \xFCst\xFCndeki sa\xE7
      tokas\u0131n\u0131 alsayd\u0131m. Belki maymuncuk olarak kullanabilirdim."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296757
    m_Localized: "Daha fazla maymuncuk bulmak i\xE7in g\xF6z\xFCm\xFC a\xE7\u0131k
      tutmal\u0131y\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 34286902860185600
    m_Localized: "Bir maymuncuk... Bununla o asma kilidi a\xE7abilirim."
    m_Metadata:
      m_Items: []
  - m_Id: 34286903040540672
    m_Localized: "Bir maymuncuk daha. Beni yakalarsa, bununla kafesten yine \xE7\u0131kabilirim."
    m_Metadata:
      m_Items: []
  - m_Id: 34292293547458560
    m_Localized: "\xC7akmak al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 34292666949566464
    m_Localized: "\xC7akmak"
    m_Metadata:
      m_Items: []
  - m_Id: 34365368158781440
    m_Localized: "Do\u011Fru y\xF6n\xFC bul ve daha sonra kilit k\u0131r\u0131lana
      dek tornaviday\u0131 o y\xF6ne do\u011Fru \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 34392063293128704
    m_Localized: "Buradan \xE7\u0131kmam laz\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 34396260386340864
    m_Localized: "Buras\u0131 da neresi?"
    m_Metadata:
      m_Items: []
  - m_Id: 34614680490999808
    m_Localized: "Yakmak i\xE7in bir ate\u015Fe ihtiyac\u0131m var."
    m_Metadata:
      m_Items: []
  - m_Id: 34614680591663104
    m_Localized: "\xD6nce \xE7akma\u011F\u0131 yakmal\u0131y\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 35779292372533248
    m_Localized: "Mengenenin kolu burada de\u011Fil. En son kafesin yan\u0131nda
      g\xF6rm\xFC\u015Ft\xFCm."
    m_Metadata:
      m_Items: []
  - m_Id: 35880272732749824
    m_Localized: "Saklanmam laz\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 36824656387112960
    m_Localized: "Mumlar\u0131 Yak"
    m_Metadata:
      m_Items: []
  - m_Id: 36824656521330688
    m_Localized: "\xC7akma\u011F\u0131 kullanarak \xE7evredeki \xE7e\u015Fitli mumlar\u0131
      ayd\u0131nlatabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 36824656521330689
    m_Localized: Tamam
    m_Metadata:
      m_Items: []
  - m_Id: 36908069135712256
    m_Localized: Sessiz Ol
    m_Metadata:
      m_Items: []
  - m_Id: 36908069202821120
    m_Localized: "Baz\u0131 b\xF6lgelerde ne kadar ses yapt\u0131\u011F\u0131na dikkat
      etmek zorundas\u0131n, yoksa seni duyabilirler."
    m_Metadata:
      m_Items: []
  - m_Id: 36908069202821121
    m_Localized: "KA\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 36908069202821122
    m_Localized: "Mikrofon Ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 36908069202821123
    m_Localized: "Oyun \xE7ok fazla ya da \xE7ok az ses alg\u0131l\u0131yorsa, mikrofon
      hassasiyetini ayarlardan de\u011Fi\u015Ftirebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 37307819441913856
    m_Localized: Mikrofon
    m_Metadata:
      m_Items: []
  - m_Id: 37307819441913857
    m_Localized: Arabam orada duruyor.
    m_Metadata:
      m_Items: []
  - m_Id: 37307819441913858
    m_Localized: Ceset nereye gitti?
    m_Metadata:
      m_Items: []
  - m_Id: 46856168847310848
    m_Localized: "K\xFC\xE7\xFCk ev"
    m_Metadata:
      m_Items: []
  - m_Id: 46856169052831744
    m_Localized: "\xC7iftlik evi"
    m_Metadata:
      m_Items: []
  - m_Id: 46856169052831745
    m_Localized: Bodrum
    m_Metadata:
      m_Items: []
  - m_Id: 46856169052831746
    m_Localized: Kamyonet
    m_Metadata:
      m_Items: []
  - m_Id: 46856169052831747
    m_Localized: "K\xF6pek a\u011F\u0131l\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 46856169052831748
    m_Localized: "\xC7iftli\u011Fin elle \xE7izilmi\u015F bir haritas\u0131. Tekrar
      bakmak i\xE7in M'ye bas."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
