  - m_Id: 5707318296604
    m_Localized: That won't work here.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: It's locked.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: I can't reach that.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: It won't budge.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Wait a moment.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: You are already hiding.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296610
    m_Localized: I have to catch my breath first.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296611
    m_Localized: I am too exhausted to hide.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296612
    m_Localized: I have to get out of here!
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: "You need {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "{0} was used."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} unlocked it."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: Bolt removed.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: It is stuck.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: This interaction is not configured.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: You have nothing to store.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "Stored: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} is already installed."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: Select a car part from your inventory first.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "You do not have {0}."
