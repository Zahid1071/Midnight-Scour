    m_Metadata:
      m_Items: []
  - m_Id: 5707318296716
    m_Localized: Submit
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296717
    m_Localized: "Hi \u2014 We're looking to grow the budget and scope for the full
      game, and your feedback is the most important guide for how we move forward."
    m_Metadata:
      m_Items: []
