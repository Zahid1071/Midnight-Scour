    m_Localized: "金属箱钥匙"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296635
    m_Localized: "口香糖"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296636
    m_Localized: "离合器"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296637
    m_Localized: "锤子"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296638
    m_Localized: "搋子"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296639
    m_Localized: "螺丝刀"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296640
    m_Localized: "火花塞"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296641
    m_Localized: "花瓶"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296642
    m_Localized: "扳手"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296643
    m_Localized: "拾取了撬棍"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296644
    m_Localized: "骨头已加入背包"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296645
    m_Localized: "粘着口香糖的骨头已加入背包"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296646
    m_Localized: "拾取了钥匙"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296647
    m_Localized: "拾取了小钥匙"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296648
    m_Localized: "拾取了口香糖"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296649
    m_Localized: "拾取了锤子"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296650
    m_Localized: "拾取了搋子"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: "拾取了螺丝刀"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: "里面好像有什么东西"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: "拾取了扳手"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "完全堵住了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: "水已经排空了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: "少了用来转动它的撬棍。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: "把撬棍用在台钳上。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: "把锤子用在撬棍上。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "把口香糖粘在了骨头上。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: "它一直打滑，我需要把什么东西粘到骨头上"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "螺丝刀断了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: "提示：利用藏身点躲避敌人。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "提示：仔细探索四周，你可能会找到重要线索。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: "提示：保持安静，敌人能听到你的声音。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "提示：手电筒电量有限，请谨慎使用。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: "提示：有些门需要特殊钥匙。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "提示：奔跑可能会引起敌人的注意。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: "提示：阅读纸条和文件来揭开故事。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: "提示：躲在阴暗角落有助于避开敌人。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: "这里什么都没有。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: "你的背包已满。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: "格栅仍然被螺栓固定着。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: "确认"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: "是"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: "否"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "确定要退出吗？\n\n未保存的进度将会丢失。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: "退出"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: "退出"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "确定要返回主菜单吗？\n\n未保存的进度将会丢失。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296680
    m_Localized: "主菜单"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296681
    m_Localized: "返回"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296682
    m_Localized: "我觉得那个花瓶里有什么东西。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296683
    m_Localized: "已丢弃 {0}。"
    m_Metadata:
