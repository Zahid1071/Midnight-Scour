    m_Localized: "自动保存"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296603
    m_Localized: "语言"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "这个在这里没用。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "锁住了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "我够不到那个。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "它纹丝不动。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: "稍等一下。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "你已经在躲藏了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296610
    m_Localized: "我得先喘口气。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296611
    m_Localized: "我太累了，没法躲藏。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296612
    m_Localized: "我得离开这里！"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: "需要{0}。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "使用了{0}。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0}把它打开了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: "螺栓已拆下。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "卡住了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "这个互动尚未配置。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "你没有东西可以存放。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "已存放：{0}。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0}已经安装好了。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "先从背包里选择一个汽车零件。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "你没有{0}。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "{0}已安装。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "这个插槽尚未配置。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "逃脱流程尚未设置。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "所有零件都已安装。你逃出去了！"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "仍然缺少：{0}。"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: "加载中..."
    m_Metadata:
      m_Items: []
