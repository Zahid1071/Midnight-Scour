    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442 \u0432\u0430\u043D\u0442\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u0430 \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: "\u0422\u0430\u043C \u0447\u0442\u043E-\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442 \u0433\u0430\u0435\u0447\u043D\u044B\u0439
      \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "\u041E\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u0430\u0441\u043E\u0440\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: "\u0412\u043E\u0434\u0430 \u0443\u0436\u0435 \u0443\u0448\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043B\u043E\u043C\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043B\u043E\u043C
      \u043D\u0430 \u0442\u0438\u0441\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043C\u043E\u043B\u043E\u0442\u043E\u043A
      \u043D\u0430 \u043B\u043E\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "\u041F\u0440\u0438\u043B\u0435\u043F\u0438\u043B \u0436\u0432\u0430\u0447\u043A\u0443
      \u043A \u043A\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442,
      \u043D\u0443\u0436\u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u043A\u043B\u0435\u0438\u0442\u044C
      \u043A \u043A\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "\u041E\u0442\u0432\u0451\u0440\u0442\u043A\u0430 \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0443\u043A\u0440\u044B\u0442\u0438\u044F, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435
      \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0439\u0442\u0438
      \u0432\u0430\u0436\u043D\u044B\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u0412\u0435\u0434\u0438\u0442\u0435
      \u0441\u0435\u0431\u044F \u0442\u0438\u0445\u043E, \u0432\u0440\u0430\u0433\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0432\u0430\u0441 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u0423 \u0432\u0430\u0448\u0435\u0433\u043E
      \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0437\u0430\u0440\u044F\u0434 \u0431\u0430\u0442\u0430\u0440\u0435\u0438,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0435\u0433\u043E
      \u0441 \u0443\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u0434\u0432\u0435\u0440\u044F\u043C \u043D\u0443\u0436\u043D\u044B \u043E\u0441\u043E\u0431\u044B\u0435
      \u043A\u043B\u044E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u0411\u0435\u0433 \u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u0427\u0438\u0442\u0430\u0439\u0442\u0435
      \u0437\u0430\u043F\u0438\u0441\u043A\u0438 \u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: "\u0421\u041E\u0412\u0415\u0422: \u041F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0442\u0451\u043C\u043D\u044B\u0445 \u0443\u0433\u043B\u0430\u0445
      \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F
      \u043E\u0442 \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: "\u0412\u0430\u0448 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C
      \u043F\u043E\u043B\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: "\u0420\u0435\u0448\u0451\u0442\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043F\u0440\u0438\u043A\u0440\u0443\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438?\n\n\u041D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: "\u0412\u044B\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E?\n\n\u041D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296680
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296681
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296682
    m_Localized: "\u0414\u0443\u043C\u0430\u044E, \u0432 \u0442\u043E\u0439 \u0432\u0430\u0437\u0435
      \u0447\u0442\u043E-\u0442\u043E \u0431\u044B\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296683
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u043E: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296684
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296685
    m_Localized: "\u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296686
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296687
    m_Localized: "\u041E\u043A\u043E\u043D\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296688
    m_Localized: "\u0421 \u0440\u0430\u043C\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296689
    m_Localized: "\u042D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u044B\u0439
      \u043F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296690
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u043D\u0438\u0437\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296691
    m_Localized: "\u041D\u0438\u0437\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296692
    m_Localized: "\u0421\u0440\u0435\u0434\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296693
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296694
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0432\u044B\u0441\u043E\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296695
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296696
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296697
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296698
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u043E\u0441\u044F\u0433\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296699
    m_Localized: "\u0423\u043D\u0438\u0442\u0430\u0437 \u0437\u0430\u0441\u043E\u0440\u0451\u043D,
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0430\u0439\u0442\u0438 \u0432\u0430\u043D\u0442\u0443\u0437.
      \u041E\u043D \u0431\u044B\u043B \u0433\u0434\u0435-\u0442\u043E \u0432 \u0432\u0435\u0434\u0440\u0435,
      \u043D\u043E \u044F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E \u0433\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296701
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u043E \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296700
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u0430 \u0441\u0432\u0435\u0447\u0430
      \u0437\u0430\u0436\u0438\u0433\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296702
    m_Localized: "\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296703
    m_Localized: "\u041F"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296704
    m_Localized: "\u0414\u0443\u043C\u0430\u044E, \u043D\u0443\u0436\u043D\u043E
      \u0443\u0434\u0430\u0440\u0438\u0442\u044C \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u2014 \u043E\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u0430\u0440\u0436\u0430\u0432\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296705
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u044D\u0442\u043E\u0442
      \u0437\u0430\u043C\u043E\u043A \u043B\u0435\u0433\u043A\u043E \u0441\u043B\u043E\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296706
    m_Localized: "\u041F\u0440\u0438\u0441\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296707
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296708
    m_Localized: Ctrl
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296709
    m_Localized: Shift
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296710
    m_Localized: "\u042F \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296711
    m_Localized: "\u041A\u0430\u043A \u0431\u044B \u0432\u044B \u043E\u0446\u0435\u043D\u0438\u043B\u0438
      \u044D\u0442\u043E\u0442 \u043E\u043F\u044B\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296712
    m_Localized: "\u041D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296713
    m_Localized: "\u0423\u0436\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296714
    m_Localized: "\u0412\u0435\u0441\u0435\u043B\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296715
    m_Localized: "*\u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E*
      \u043F\u043E\u043B\u0435 \u043E\u0442\u0437\u044B\u0432\u0430"
    m_Metadata:
      m_Items: []
