    m_Metadata:
      m_Items: []
  - m_Id: 5707318296745
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296746
    m_Localized: "Butcher \u0443\u0441\u0442\u0440\u043E\u0438\u043B \u0442\u0435\u0431\u0435
