    m_Localized: "Clé récupérée"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296647
    m_Localized: "Petite clé récupérée"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296648
    m_Localized: "Chewing-gum récupéré"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296649
    m_Localized: "Marteau récupéré"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296650
    m_Localized: "Ventouse récupérée"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: "Tournevis récupéré"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: "Il y a quelque chose à l'intérieur"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: "Clé à molette récupérée"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "C'est complètement bouché."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: "L'eau est déjà partie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: "Il manque la barre pour le faire tourner."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: "Utilise la barre de fer sur l'étau."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: Utilise le marteau sur la barre de fer.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "A collé le chewing-gum sur l'os."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: "Ça glisse sans arrêt, je dois coller quelque chose sur l'os"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "Le tournevis s'est cassé."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: "ASTUCE : Utilisez les cachettes pour échapper aux ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: ASTUCE : Explorez attentivement les environs, vous pourriez trouver des indices importants.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: ASTUCE : Restez silencieux, les ennemis peuvent vous entendre.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "ASTUCE : Votre lampe torche a une batterie limitée, utilisez-la avec prudence."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: "ASTUCE : Certaines portes nécessitent des clés spéciales."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: ASTUCE : Courir peut attirer l'attention des ennemis.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: "ASTUCE : Lisez les notes et documents pour découvrir l'histoire."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: "ASTUCE : Se cacher dans les coins sombres aide à se protéger des ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: Il n'y a rien ici.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: Votre inventaire est plein.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: "La grille est encore boulonnée."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: Confirmer
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "Voulez-vous vraiment quitter ?\n\nLa progression non sauvegardée sera perdue."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: Quitter
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: Quitter
    m_Metadata:
      m_Items: []
