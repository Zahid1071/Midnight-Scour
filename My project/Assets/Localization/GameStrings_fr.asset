  - m_Id: 5707318296603
    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "\xC7a ne marchera pas ici."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "C'est verrouill\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "C'est trop loin."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "\xC7a ne bouge pas."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Attends un instant.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Tu es d\xE9j\xE0 cach\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: Il te faut {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "{0} a \xE9t\xE9 utilis\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} a d\xE9bloqu\xE9 ceci."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: "Boulon retir\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "C'est coinc\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Cette interaction n'est pas configur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "Tu n'as rien \xE0 ranger."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "Rang\xE9 : {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} est d\xE9j\xE0 install\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "S\xE9lectionne d'abord une pi\xE8ce de voiture dans ton inventaire."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: Tu n'as pas {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "{0} install\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Cet emplacement n'est pas configur\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "La s\xE9quence d'\xE9vasion n'est pas configur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Toutes les pi\xE8ces sont install\xE9es. Tu t'es \xE9chapp\xE9
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: 'Il manque encore : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Chargement...
    m_Metadata:
      m_Items: []
