  - m_Id: 5707318296603
    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "Ça ne marchera pas ici."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "C'est verrouillé."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "Je ne peux pas atteindre ça."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "Ça ne bouge pas."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Attends un instant.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Tu es déjà caché."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296610
    m_Localized: Je dois d'abord reprendre mon souffle.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296611
    m_Localized: "Je suis trop épuisé pour me cacher."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296612
    m_Localized: Je dois sortir d'ici !
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: "Il te faut {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "{0} a été utilisé."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} a débloqué ceci."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: "Boulon retiré."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "C'est coincé."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Cette interaction n'est pas configurée."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "Tu n'as rien à ranger."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "Rangé : {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} est déjà installé."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "Sélectionne d'abord une pièce de voiture dans ton inventaire."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "Tu n'as pas {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "{0} installé."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Cet emplacement n'est pas configuré."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "La séquence d'évasion n'est pas configurée."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Toutes les pièces sont installées. Tu t'es échappé !"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "Il manque encore : {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Chargement...
    m_Metadata:
      m_Items: []
