    m_Localized: Utiliser l'objet
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296697
    m_Localized: "Lâcher"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296698
    m_Localized: "Il n'y a rien à portée de main."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296699
    m_Localized: "Les toilettes sont bouchées, je ne trouve pas la ventouse. Elle était quelque part dans un seau, mais je ne me souviens plus où."
    m_Metadata:
      m_Items: []
