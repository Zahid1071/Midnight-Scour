    m_Metadata:
      m_Items: []
  - m_Id: 5707318296682
    m_Localized: Acho que tinha alguma coisa dentro daquele vaso.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296683
    m_Localized: '{0} foi solto.'
    m_Metadata:
      m_Items: []
