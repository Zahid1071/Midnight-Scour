    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "Est\xE1 completamente entupido."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: "A \xE1gua j\xE1 se foi."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: Falta a barra para girar isso.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
