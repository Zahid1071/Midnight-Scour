    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: Grudou o chiclete no osso.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: Fica escorregando, preciso grudar algo no osso
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: A chave de fenda quebrou.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "DICA: Explore com cuidado, voc\xEA pode encontrar pistas importantes."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: "DICA: Fique em sil\xEAncio, os inimigos podem ouvir voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "DICA: Correr pode chamar a aten\xE7\xE3o dos inimigos."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: "DICA: Leia bilhetes e documentos para descobrir a hist\xF3ria."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: Nada aqui.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: "Seu invent\xE1rio est\xE1 cheio."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: "A grade ainda est\xE1 parafusada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: "N\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "Tem certeza de que deseja sair?\n\nO progresso n\xE3o salvo ser\xE1
      perdido."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "Tem certeza de que deseja voltar ao menu principal?\n\nO progresso
      n\xE3o salvo ser\xE1 perdido."
    m_Metadata:
      m_Items: []
