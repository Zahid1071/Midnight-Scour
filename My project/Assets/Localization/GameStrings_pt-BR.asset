  - m_Id: 5707318296603
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "Isso não vai funcionar aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "Está trancado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "Não consigo alcançar isso."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "Não sai do lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Espere um momento.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Você já está se escondendo."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296610
    m_Localized: "Preciso recuperar o fôlego primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296611
    m_Localized: Estou exausto demais para me esconder.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296612
    m_Localized: Eu preciso sair daqui!
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: "Você precisa de {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "{0} foi usado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} destrancou isso."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: Parafuso removido.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "Está emperrado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Esta interação não está configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "Você não tem nada para guardar."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "Guardado: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} já está instalado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "Selecione uma peça do carro no seu inventário primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "Você não tem {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "{0} instalado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Este slot não está configurado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "A sequência de fuga não está configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Todas as peças instaladas. Você escapou!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "Ainda faltando: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Carregando...
    m_Metadata:
      m_Items: []
