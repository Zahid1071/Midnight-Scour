    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "Isso n\xE3o vai funcionar aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "Est\xE1 trancado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "Est\xE1 longe demais."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "N\xE3o sai do lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Espere um momento.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Voc\xEA j\xE1 est\xE1 se escondendo."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: "Voc\xEA precisa de {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: '{0} foi usado.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: '{0} destrancou isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: Parafuso removido.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "Est\xE1 emperrado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Esta intera\xE7\xE3o n\xE3o est\xE1 configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "Voc\xEA n\xE3o tem nada para guardar."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: 'Guardado: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} j\xE1 est\xE1 instalado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "Selecione uma pe\xE7a do carro no seu invent\xE1rio primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "Voc\xEA n\xE3o tem {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: '{0} instalado.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Este slot n\xE3o est\xE1 configurado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "A sequ\xEAncia de fuga n\xE3o est\xE1 configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Todas as pe\xE7as instaladas. Voc\xEA escapou!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: 'Ainda faltando: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Carregando...
    m_Metadata:
      m_Items: []
