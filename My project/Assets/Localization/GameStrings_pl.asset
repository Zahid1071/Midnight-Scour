  m_TableData:
  - m_Id: 5707297325056
    m_Localized: Ustawienia
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325057
    m_Localized: "Wyj\u015Bcie"
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325058
    m_Localized: Wstecz
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325059
    m_Localized: Zastosuj
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325060
    m_Localized: "Domy\u015Blne"
    m_Metadata:
      m_Items: []
  - m_Id: 1843970048000
    m_Localized: Kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325061
    m_Localized: Nowa gra
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325062
    m_Localized: "Napisy ko\u0144cowe"
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325063
    m_Localized: "Zapisz gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 5707297325064
    m_Localized: PAUZA
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296576
    m_Localized: "Wzn\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296577
    m_Localized: "Dzi\u0119kujemy za granie w Midnight Scour"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296578
    m_Localized: "naci\u015Bnij esc, aby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296579
    m_Localized: "naci\u015Bnij dowolny klawisz, aby kontynuowa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296580
    m_Localized: "Mo\u017Cesz czyta\u0107 notatki, aby znale\u017A\u0107 wskaz\xF3wki"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296581
    m_Localized: "U\u017Cywaj kryj\xF3wek, aby unikn\u0105\u0107 zab\xF3jcy"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296582
    m_Localized: "Ha\u0142asowanie mo\u017Ce zaalarmowa\u0107 zab\xF3jc\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296583
    m_Localized: "Naci\u015Bnij {0}, aby rzuci\u0107, przytrzymaj, aby po\u0142o\u017Cy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296584
    m_Localized: "U\u017Cyj/Po\u0142\u0105cz przedmiot"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296585
    m_Localized: Interakcja
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296586
    m_Localized: USTAWIENIA
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296587
    m_Localized: Ekran
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296588
    m_Localized: "D\u017Awi\u0119k"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296589
    m_Localized: Sterowanie
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296590
    m_Localized: Rozgrywka
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296591
    m_Localized: "Og\xF3lne"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296592
    m_Localized: "G\u0142o\u015Bno\u015B\u0107 g\u0142\xF3wna"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296593
    m_Localized: "G\u0142o\u015Bno\u015B\u0107 muzyki"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296594
    m_Localized: "G\u0142o\u015Bno\u015B\u0107 efekt\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296595
    m_Localized: "Jasno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296596
    m_Localized: "Czu\u0142o\u015B\u0107 myszy"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296800
    m_Localized: "Czu\u0142o\u015B\u0107 mikrofonu"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296597
    m_Localized: "Rozdzielczo\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296598
    m_Localized: "Pe\u0142ny ekran"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296599
    m_Localized: "Tryb wy\u015Bwietlania"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296600
    m_Localized: "Jako\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296601
    m_Localized: Synchronizacja pionowa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296602
    m_Localized: Autozapis
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296603
    m_Localized: "J\u0119zyk"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "To tutaj nie zadzia\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "Zamkni\u0119te na klucz."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: To za daleko.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: "Nie chce drgn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Chwila moment.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Ju\u017C si\u0119 ukrywasz."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: Potrzebujesz {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "U\u017Cyto {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} to odblokowa\u0142."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: "\u015Aruba usuni\u0119ta."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "To utkn\u0119\u0142o."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: Ta interakcja nie jest skonfigurowana.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: Nie masz nic do schowania.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: 'Schowano: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} jest ju\u017C zainstalowany."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "Najpierw wybierz cz\u0119\u015B\u0107 samochodu z ekwipunku."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: Nie masz {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: '{0} zainstalowano.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: Ten slot nie jest skonfigurowany.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "Sekwencja ucieczki nie zosta\u0142a skonfigurowana."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Wszystkie cz\u0119\u015Bci zainstalowane. Uciek\u0142e\u015B!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: 'Nadal brakuje: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Wczytywanie...
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296630
    m_Localized: "\u0141om"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296631
    m_Localized: "Ko\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296632
    m_Localized: "Ko\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296633
    m_Localized: Klucz do piwnicy
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296634
    m_Localized: Metalowy klucz do skrzynki
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296635
    m_Localized: "Guma do \u017Cucia"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296636
    m_Localized: "Sprz\u0119g\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296637
    m_Localized: "M\u0142otek"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296638
    m_Localized: Przepychacz
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296639
    m_Localized: "\u015Arubokr\u0119t"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296640
    m_Localized: "\u015Awieca zap\u0142onowa"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296641
    m_Localized: Wazon
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296642
    m_Localized: "Klucz p\u0142aski"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296643
    m_Localized: "Podniesiono \u0142om"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296644
    m_Localized: "Ko\u015B\u0107 dodana do ekwipunku"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296645
    m_Localized: "Ko\u015B\u0107 z gum\u0105 dodana do ekwipunku"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296646
    m_Localized: Podniesiono klucz
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296647
    m_Localized: "Podniesiono ma\u0142y klucz"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296648
    m_Localized: "Podniesiono gum\u0119 do \u017Cucia"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296649
    m_Localized: "Podniesiono m\u0142otek"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296650
    m_Localized: Podniesiono przepychacz
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: "Podniesiono \u015Brubokr\u0119t"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: "Co\u015B w tym jest"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: "Podniesiono klucz p\u0142aski"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "Jest ca\u0142kowicie zatkany."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: "Woda ju\u017C znikn\u0119\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: "Brakuje \u0142omu, \u017Ceby to obr\xF3ci\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: "U\u017Cyj \u0142omu na imadle."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: "U\u017Cyj m\u0142otka na \u0142omie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "Przyklei\u0142 gum\u0119 do ko\u015Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: "Ci\u0105gle si\u0119 ze\u015Blizguje, musz\u0119 co\u015B przyklei\u0107
      do ko\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "\u015Arubokr\u0119t si\u0119 z\u0142ama\u0142."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: "WSKAZ\xD3WKA: U\u017Cywaj kryj\xF3wek, aby unikn\u0105\u0107 wrog\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "WSKAZ\xD3WKA: Eksploruj otoczenie uwa\u017Cnie, mo\u017Cesz znale\u017A\u0107
      wa\u017Cne wskaz\xF3wki."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: "WSKAZ\xD3WKA: Zachowuj cisz\u0119, wrogowie mog\u0105 ci\u0119
      us\u0142ysze\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "WSKAZ\xD3WKA: Twoja latarka ma ograniczon\u0105 bateri\u0119, u\u017Cywaj
      jej rozwa\u017Cnie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: "WSKAZ\xD3WKA: Niekt\xF3re drzwi wymagaj\u0105 specjalnych kluczy."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "WSKAZ\xD3WKA: Bieganie mo\u017Ce zwr\xF3ci\u0107 uwag\u0119 wrog\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: "WSKAZ\xD3WKA: Czytaj notatki i dokumenty, aby odkry\u0107 fabu\u0142\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: "WSKAZ\xD3WKA: Ukrywanie si\u0119 w ciemnych k\u0105tach pomaga
      unikn\u0105\u0107 wrog\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: Nic tu nie ma.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: "Tw\xF3j ekwipunek jest pe\u0142ny."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: "Kratka jest nadal przykr\u0119cona."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: "Potwierd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "Czy na pewno chcesz wyj\u015B\u0107?\n\nNiezapisany post\u0119p
      zostanie utracony."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: "Wyj\u015Bcie"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: "Wyjd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "Czy na pewno chcesz wr\xF3ci\u0107 do menu g\u0142\xF3wnego?\n\nNiezapisany
      post\u0119p zostanie utracony."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296680
    m_Localized: "Menu g\u0142\xF3wne"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296681
    m_Localized: "Wr\xF3\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296682
    m_Localized: "My\u015Bl\u0119, \u017Ce co\u015B by\u0142o w tym wazonie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296683
    m_Localized: Upuszczono {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296684
    m_Localized: "W\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296685
    m_Localized: "Wy\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296686
    m_Localized: "Pe\u0142ny ekran"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296687
    m_Localized: Okienkowy
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296688
    m_Localized: "Z ramk\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296689
    m_Localized: "Pe\u0142ny ekran (wy\u0142\u0105czny)"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296690
    m_Localized: Bardzo niski
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296691
    m_Localized: Niski
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296692
    m_Localized: "\u015Aredni"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296693
    m_Localized: Wysoki
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296694
    m_Localized: Bardzo wysoki
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296695
    m_Localized: Ultra
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296696
    m_Localized: "U\u017Cyj przedmiotu"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296697
    m_Localized: "Upu\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296698
    m_Localized: "Nie ma nic w zasi\u0119gu."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296699
    m_Localized: "Toaleta jest zatkana, nie mog\u0119 znale\u017A\u0107 przepychacza.
      By\u0142 gdzie\u015B w wiaderku, ale nie pami\u0119tam gdzie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296701
    m_Localized: "Podniesiono sprz\u0119g\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296700
    m_Localized: "Podniesiono \u015Bwiec\u0119 zap\u0142onow\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296702
    m_Localized: E
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296703
    m_Localized: G
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296704
    m_Localized: "Chyba musz\u0119 to uderzy\u0107 czym\u015B, \u017Ceby obr\xF3ci\u0107
      \u2014 jest kompletnie zardzewia\u0142e"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296705
    m_Localized: "Ta k\u0142\xF3dka wygl\u0105da na \u0142atw\u0105 do z\u0142amania."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296706
    m_Localized: Kucaj
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296707
    m_Localized: Bieg
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296708
    m_Localized: Ctrl
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296709
    m_Localized: Shift
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296710
    m_Localized: "Blokuj\u0119 przej\u015Bcie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296711
    m_Localized: "Jak oceni\u0142by\u015B to do\u015Bwiadczenie?"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296712
    m_Localized: "Napi\u0119cie"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296713
    m_Localized: Horror
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296714
    m_Localized: Zabawa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296715
    m_Localized: '*opcjonalne* pole opinii'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296716
    m_Localized: "Wy\u015Blij"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296717
    m_Localized: "Cze\u015B\u0107 \u2014 Chcemy zwi\u0119kszy\u0107 bud\u017Cet i
      zakres pe\u0142nej gry, a wasza opinia jest dla nas najwa\u017Cniejsz\u0105
      wskaz\xF3wk\u0105 na dalsz\u0105 drog\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296718
    m_Localized: '?'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296719
    m_Localized: "Wysy\u0142anie..."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296720
    m_Localized: "Wys\u0142ano"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296721
    m_Localized: "Pon\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296722
    m_Localized: "Oce\u0144 wszystko"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296723
    m_Localized: Wymagana konfiguracja
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296724
    m_Localized: "Dodaj do listy \u017Cycze\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296725
    m_Localized: "Wyjd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296726
    m_Localized: "Ju\u017C to zrobi\u0142e\u015B"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296727
    m_Localized: Zaktualizowano
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296728
    m_Localized: "Zab\xF3jca rozpozna twoje powtarzalne ruchy i si\u0119 do nich
      dostosuje."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296729
    m_Localized: "Uda\u0142o si\u0119, idealny timing"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296730
    m_Localized: "Mog\u0119 zgra\u0107 uderzenie m\u0142otkiem z grzmotem"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296731
    m_Localized: "To b\u0119dzie g\u0142o\u015Bne, nie mog\u0119 teraz uderzy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296732
    m_Localized: "Uderzy\u0142em za p\xF3\u017Ano, z\u0142apie mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296733
    m_Localized: "Wepchnij \u015Brubokr\u0119t."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296734
    m_Localized: "Szarp gwa\u0142townie, by z\u0142ama\u0107 zamek."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296735
    m_Localized: "Uderzy\u0142em za wcze\u015Bnie, zostan\u0119 z\u0142apany"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296736
    m_Localized: "Uderzy\u0142em za p\xF3\u017Ano, zostan\u0119 z\u0142apany"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296737
    m_Localized: "Utkn\u0119\u0142o, spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296738
    m_Localized: "Butcher widzia\u0142, jak si\u0119 ukrywasz."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296739
    m_Localized: "Zrobi\u0142e\u015B za du\u017Co ha\u0142asu."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296740
    m_Localized: "Ukrywa\u0142e\u015B si\u0119 wci\u0105\u017C w tym samym miejscu."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296741
    m_Localized: "Nie ukry\u0142e\u015B d\u017Awi\u0119ku m\u0142otka grzmotem."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296742
    m_Localized: "Butcher ci\u0119 zobaczy\u0142."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296743
    m_Localized: "Zosta\u0142e\u015B z\u0142apany."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296744
    m_Localized: Od nowa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296745
    m_Localized: "Menu g\u0142\xF3wne"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296746
    m_Localized: "Butcher zastawi\u0142 na ciebie zasadzk\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296747
    m_Localized: "Wytrychy pozwalaj\u0105 zachowa\u0107 post\u0119p po z\u0142apaniu."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296748
    m_Localized: Wytrych
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296749
    m_Localized: Podniesiono wytrych
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296750
    m_Localized: Kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296751
    m_Localized: "Przytrzymaj prawy przycisk myszy, aby nacisn\u0105\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296752
    m_Localized: "U\u017Cyj myszy, aby przesun\u0105\u0107 wytrych, i lewego przycisku,
      aby podnie\u015B\u0107 bolce"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296753
    m_Localized: Bolec ustawiony
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296754
    m_Localized: Zamek otwarty
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296755
    m_Localized: "Drzwi s\u0105 spi\u0119te \u0142a\u0144cuchem."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296756
    m_Localized: "Kiedy z\u0142apano mnie za pierwszym razem, spi\u0105\u0142 drzwi
      k\u0142\xF3dk\u0105. Szkoda, \u017Ce nie ma przy mnie tej spinki do w\u0142os\xF3w
      z wierzchu tamtej toalety. Mo\u017Ce da\u0142oby si\u0119 u\u017Cy\u0107 jej
      jako wytrychu."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296757
    m_Localized: "Musz\u0119 mie\u0107 oczy otwarte, \u017Ceby znale\u017A\u0107
      wi\u0119cej wytrych\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 34286902860185600
    m_Localized: "Wytrych... M\xF3g\u0142bym nim otworzy\u0107 t\u0119 k\u0142\xF3dk\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 34286903040540672
    m_Localized: "Kolejny wytrych. Je\u015Bli mnie z\u0142apie, u\u017Cyj\u0119 go,
      \u017Ceby zn\xF3w wydosta\u0107 si\u0119 z klatki."
    m_Metadata:
      m_Items: []
  - m_Id: 34292293547458560
    m_Localized: "Podniesiono zapalniczk\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 34292666949566464
    m_Localized: Zapalniczka
    m_Metadata:
      m_Items: []
  - m_Id: 34365368158781440
    m_Localized: "Zablokowa\u0142o si\u0119. Przepchnij na si\u0142\u0119 albo wyjmij
      i wepchnij ponownie, \u017Ceby poluzowa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 34392063293128704
    m_Localized: "Musz\u0119 si\u0119 st\u0105d wydosta\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 34396260386340864
    m_Localized: Co to za miejsce?
    m_Metadata:
      m_Items: []
  - m_Id: 34614680490999808
    m_Localized: "Potrzebuj\u0119 ognia, \u017Ceby j\u0105 zapali\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 34614680591663104
    m_Localized: "Najpierw musz\u0119 zapali\u0107 zapalniczk\u0119."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
