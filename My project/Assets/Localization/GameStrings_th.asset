  - m_Id: 5707318296704
    m_Localized: "\u0E04\u0E07\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E04\u0E32\u0E30\u0E14\u0E49\u0E27\u0E22\u0E2D\u0E30\u0E44\u0E23\u0E2A\u0E31\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E16\u0E36\u0E07\u0E08\u0E30\u0E2B\u0E21\u0E38\u0E19\u0E44\u0E14\u0E49
      \u0E21\u0E31\u0E19\u0E2A\u0E19\u0E34\u0E21\u0E15\u0E34\u0E14\u0E41\u0E19\u0E48\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296705
    m_Localized: "\u0E01\u0E38\u0E0D\u0E41\u0E08\u0E25\u0E47\u0E2D\u0E01\u0E19\u0E35\u0E49\u0E14\u0E39\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E08\u0E30\u0E2B\u0E31\u0E01\u0E07\u0E48\u0E32\u0E22"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296706
    m_Localized: "\u0E22\u0E48\u0E2D\u0E15\u0E31\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296707
    m_Localized: "\u0E27\u0E34\u0E48\u0E07"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296708
    m_Localized: Ctrl
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296709
    m_Localized: Shift
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296710
    m_Localized: "\u0E09\u0E31\u0E19\u0E02\u0E27\u0E32\u0E07\u0E17\u0E32\u0E07\u0E2D\u0E22\u0E39\u0E48"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296711
    m_Localized: "\u0E04\u0E38\u0E13\u0E08\u0E30\u0E43\u0E2B\u0E49\u0E04\u0E30\u0E41\u0E19\u0E19\u0E1B\u0E23\u0E30\u0E2A\u0E1A\u0E01\u0E32\u0E23\u0E13\u0E4C\u0E19\u0E35\u0E49\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E44\u0E23?"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296712
    m_Localized: "\u0E04\u0E27\u0E32\u0E21\u0E15\u0E36\u0E07\u0E40\u0E04\u0E23\u0E35\u0E22\u0E14"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296713
    m_Localized: "\u0E04\u0E27\u0E32\u0E21\u0E19\u0E48\u0E32\u0E01\u0E25\u0E31\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296714
    m_Localized: "\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E19\u0E38\u0E01"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296715
    m_Localized: "*\u0E44\u0E21\u0E48\u0E1A\u0E31\u0E07\u0E04\u0E31\u0E1A* \u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E41\u0E2A\u0E14\u0E07\u0E04\u0E27\u0E32\u0E21\u0E04\u0E34\u0E14\u0E40\u0E2B\u0E47\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296716
    m_Localized: "\u0E2A\u0E48\u0E07"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296717
    m_Localized: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35 \u2014 \u0E40\u0E23\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E02\u0E22\u0E32\u0E22\u0E07\u0E1A\u0E1B\u0E23\u0E30\u0E21\u0E32\u0E13\u0E41\u0E25\u0E30\u0E02\u0E2D\u0E1A\u0E40\u0E02\u0E15\u0E02\u0E2D\u0E07\u0E40\u0E01\u0E21\u0E40\u0E15\u0E47\u0E21
      \u0E41\u0E25\u0E30\u0E04\u0E27\u0E32\u0E21\u0E04\u0E34\u0E14\u0E40\u0E2B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E04\u0E37\u0E2D\u0E41\u0E19\u0E27\u0E17\u0E32\u0E07\u0E17\u0E35\u0E48\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E43\u0E19\u0E01\u0E32\u0E23\u0E01\u0E49\u0E32\u0E27\u0E15\u0E48\u0E2D\u0E44\u0E1B"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296718
    m_Localized: '?'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296719
    m_Localized: "\u0E01\u0E33\u0E25\u0E31\u0E07\u0E2A\u0E48\u0E07..."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296720
    m_Localized: "\u0E2A\u0E48\u0E07\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296721
    m_Localized: "\u0E25\u0E2D\u0E07\u0E43\u0E2B\u0E21\u0E48"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296722
    m_Localized: "\u0E43\u0E2B\u0E49\u0E04\u0E30\u0E41\u0E19\u0E19\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E21\u0E14"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296723
    m_Localized: "\u0E15\u0E49\u0E2D\u0E07\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296724
    m_Localized: "\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E43\u0E19\u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E44\u0E14\u0E49!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296725
    m_Localized: "\u0E2D\u0E2D\u0E01"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296726
    m_Localized: "\u0E2A\u0E48\u0E07\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296727
    m_Localized: "\u0E2D\u0E31\u0E1B\u0E40\u0E14\u0E15\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296728
    m_Localized: "\u0E06\u0E32\u0E15\u0E01\u0E23\u0E08\u0E30\u0E08\u0E33\u0E1E\u0E24\u0E15\u0E34\u0E01\u0E23\u0E23\u0E21\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E17\u0E33\u0E0B\u0E49\u0E33\u0E41\u0E25\u0E49\u0E27\u0E1B\u0E23\u0E31\u0E1A\u0E15\u0E31\u0E27\u0E15\u0E32\u0E21"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296729
    m_Localized: "\u0E2A\u0E33\u0E40\u0E23\u0E47\u0E08\u0E41\u0E25\u0E49\u0E27 \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E14\u0E35\u0E21\u0E32\u0E01"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296730
    m_Localized: "\u0E09\u0E31\u0E19\u0E08\u0E31\u0E1A\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E15\u0E35\u0E04\u0E49\u0E2D\u0E19\u0E43\u0E2B\u0E49\u0E15\u0E23\u0E07\u0E01\u0E31\u0E1A\u0E1F\u0E49\u0E32\u0E23\u0E49\u0E2D\u0E07\u0E44\u0E14\u0E49"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296731
    m_Localized: "\u0E14\u0E31\u0E07\u0E40\u0E01\u0E34\u0E19\u0E44\u0E1B \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E15\u0E35\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296732
    m_Localized: "ฉันตีช้าเกินไป เขาจะจับฉันได้"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296733
    m_Localized: "ดันไขควงเข้าไป"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296734
    m_Localized: "เขย่าแรงๆ เพื่องัดกุญแจ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296735
    m_Localized: "ฉันตีเร็วเกินไป ฉันจะถูกจับ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296736
    m_Localized: "ฉันตีช้าเกินไป ฉันจะถูกจับ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296737
    m_Localized: "ติดแล้ว ลองใหม่"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296738
    m_Localized: "Butcher เห็นคุณซ่อน"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296739
    m_Localized: "คุณส่งเสียงดังเกินไป"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296740
    m_Localized: "คุณซ่อนที่เดิมซ้ำๆ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296741
    m_Localized: "คุณกลบเสียงค้อนด้วยฟ้าร้องไม่สำเร็จ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296742
    m_Localized: "Butcher เห็นคุณ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296743
    m_Localized: "คุณถูกจับแล้ว"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296744
    m_Localized: "เริ่มใหม่"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296745
    m_Localized: "เมนูหลัก"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296746
    m_Localized: "Butcher ซุ่มโจมตีคุณ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296747
    m_Localized: "ที่งัดกุญแจช่วยให้คุณเก็บความคืบหน้าไว้ได้หลังถูกจับ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296748
    m_Localized: "ที่งัดกุญแจ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296749
    m_Localized: "เก็บที่งัดกุญแจแล้ว"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296750
    m_Localized: "????????????"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296751
    m_Localized: "\u0E01\u0E14\u0E04\u0E25\u0E34\u0E01\u0E02\u0E27\u0E32\u0E04\u0E49\u0E32\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E2D\u0E2D\u0E01\u0E41\u0E23\u0E07"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296752
    m_Localized: "\u0E43\u0E0A\u0E49\u0E40\u0E21\u0E32\u0E2A\u0E4C\u0E40\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E07\u0E31\u0E14\u0E01\u0E38\u0E0D\u0E41\u0E08\u0E41\u0E25\u0E49\u0E27\u0E04\u0E25\u0E34\u0E01\u0E0B\u0E49\u0E32\u0E22\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E07\u0E31\u0E14\u0E2B\u0E21\u0E38\u0E14"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296753
    m_Localized: "\u0E2B\u0E21\u0E38\u0E14\u0E15\u0E31\u0E49\u0E07\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296754
    m_Localized: "\u0E44\u0E02\u0E01\u0E38\u0E0D\u0E41\u0E08\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296755
    m_Localized: "ประตูถูกล็อกด้วยโซ่"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296756
    m_Localized: "ตอนที่ฉันถูกจับครั้งแรก เขาล็อกประตูด้วยกุญแจคล้อง อยากจะเก็บกิ๊บบนโถส้วมนั้นไว้เหลือเกิน บางทีอาจใช้เป็นที่งัดกุญแจได้"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296757
    m_Localized: "ฉันต้องคอยหาที่งัดกุญแจเพิ่ม"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
