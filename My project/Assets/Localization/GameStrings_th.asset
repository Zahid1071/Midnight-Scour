    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: "ถอดสลักออกแล้ว"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "ติดอยู่"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "การโต้ตอบนี้ยังไม่ได้ตั้งค่า"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: "ไม่มีอะไรจะเก็บ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "เก็บแล้ว: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} ติดตั้งแล้ว"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: "เลือกชิ้นส่วนรถจากกระเป๋าก่อน"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "คุณไม่มี {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "ติดตั้ง {0} แล้ว"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "ช่องนี้ยังไม่ได้ตั้งค่า"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "ลำดับการหลบหนียังไม่ได้ตั้งค่า"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "ติดตั้งชิ้นส่วนครบแล้ว คุณหนีรอดแล้ว!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "ยังขาด: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: "กำลังโหลด..."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296630
    m_Localized: "เหล็กเส้น"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296631
    m_Localized: "กระดูก"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296632
    m_Localized: "กระดูก"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296633
    m_Localized: "กุญแจห้องใต้ดิน"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296634
    m_Localized: "กุญแจกล่องโลหะ"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296635
