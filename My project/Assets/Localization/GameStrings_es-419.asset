    m_Metadata:
      m_Items: []
  - m_Id: 5707318296643
    m_Localized: Recogiste la barra de metal
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296644
    m_Localized: "Hueso añadido al inventario"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296645
    m_Localized: "Hueso con chicle añadido al inventario"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296646
    m_Localized: Recogiste la llave
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296647
    m_Localized: "Recogiste la llave pequeña"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296648
    m_Localized: Recogiste el chicle
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296649
    m_Localized: Recogiste el martillo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296650
    m_Localized: Recogiste el desatascador
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: Recogiste el destornillador
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: Hay algo adentro
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: Recogiste la llave inglesa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "Está completamente atascado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: El agua ya se fue.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: "Le falta la barra para girarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: Usa la barra en el tornillo de banco.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: Usa el martillo en la barra.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "Pegó el chicle en el hueso."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: Sigue resbalando, necesito pegar algo al hueso
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "El destornillador se rompió."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: CONSEJO: Usa los escondites para evitar a los enemigos.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "CONSEJO: Explora con cuidado, podrías encontrar pistas importantes."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: CONSEJO: Mantente en silencio, los enemigos pueden escucharte.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "CONSEJO: Tu linterna tiene batería limitada, úsala con cuidado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: CONSEJO: Algunas puertas requieren llaves especiales.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "CONSEJO: Correr puede llamar la atención de los enemigos."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: CONSEJO: Lee notas y documentos para descubrir la historia.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: CONSEJO: Esconderte en rincones oscuros te ayuda a protegerte de los enemigos.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: "No hay nada aquí."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: "Tu inventario está lleno."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: La reja sigue atornillada.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: "Sí"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "¿Seguro que quieres salir?\n\nSe perderá el progreso no guardado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "¿Seguro que quieres volver al menú principal?\n\nSe perderá el progreso no guardado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296680
    m_Localized: "Menú principal"
    m_Metadata:
      m_Items: []
