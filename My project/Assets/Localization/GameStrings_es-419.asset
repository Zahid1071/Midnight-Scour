  - m_Id: 5707318296602
    m_Localized: Autoguardado
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296603
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "Eso no va a funcionar aquí."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "Está cerrado con llave."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: No puedo alcanzar eso.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: No se mueve.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Espera un momento.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Ya te estás escondiendo."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296610
    m_Localized: Primero tengo que recuperar el aliento.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296611
    m_Localized: Estoy demasiado agotado para esconderme.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296612
    m_Localized: "¡Tengo que salir de aquí!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: "Necesitas {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "Se usó {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} lo desbloqueó."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: Perno retirado.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "Está atascado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Esta interacción no está configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: No tienes nada que guardar.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: "Guardado: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} ya está instalado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: Selecciona primero una pieza de auto de tu inventario.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: "No tienes {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: "{0} instalado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Esta ranura no está configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "La secuencia de escape no está configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Todas las piezas instaladas. ¡Escapaste!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "Todavía falta: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Cargando...
    m_Metadata:
      m_Items: []
