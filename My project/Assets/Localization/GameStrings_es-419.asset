    m_Metadata:
      m_Items: []
  - m_Id: 5707318296601
    m_Localized: "Sincronizaci\xF3n vertical"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296602
    m_Localized: Autoguardado
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296603
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296604
    m_Localized: "Eso no va a funcionar aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296605
    m_Localized: "Est\xE1 cerrado con llave."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296606
    m_Localized: "Est\u00E1 demasiado lejos."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296607
    m_Localized: No se mueve.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296608
    m_Localized: Espera un momento.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296609
    m_Localized: "Ya te est\xE1s escondiendo."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296613
    m_Localized: Necesitas {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296614
    m_Localized: "Se us\xF3 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296615
    m_Localized: "{0} lo desbloque\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296616
    m_Localized: Perno retirado.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296617
    m_Localized: "Est\xE1 atascado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296618
    m_Localized: "Esta interacci\xF3n no est\xE1 configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296619
    m_Localized: No tienes nada que guardar.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296620
    m_Localized: 'Guardado: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296621
    m_Localized: "{0} ya est\xE1 instalado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296622
    m_Localized: Selecciona primero una pieza de auto de tu inventario.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296623
    m_Localized: No tienes {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296624
    m_Localized: '{0} instalado.'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296625
    m_Localized: "Esta ranura no est\xE1 configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296626
    m_Localized: "La secuencia de escape no est\xE1 configurada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296627
    m_Localized: "Todas las piezas instaladas. \xA1Escapaste!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296628
    m_Localized: "Todav\xEDa falta: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296629
    m_Localized: Cargando...
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296630
    m_Localized: Barra de metal
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296631
    m_Localized: Hueso
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296632
    m_Localized: Hueso
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296633
    m_Localized: "Llave del s\xF3tano"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296634
    m_Localized: "Llave de la caja met\xE1lica"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296635
    m_Localized: Chicle
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296636
    m_Localized: Embrague
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296637
    m_Localized: Martillo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296638
    m_Localized: Desatascador
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296639
    m_Localized: Destornillador
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296640
    m_Localized: "Buj\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296641
    m_Localized: Florero
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296642
    m_Localized: Llave inglesa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296643
    m_Localized: Recogiste la barra de metal
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296644
    m_Localized: "Hueso a\xF1adido al inventario"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296645
    m_Localized: "Hueso con chicle a\xF1adido al inventario"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296646
    m_Localized: Recogiste la llave
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296647
    m_Localized: "Recogiste la llave peque\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296648
    m_Localized: Recogiste el chicle
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296649
    m_Localized: Recogiste el martillo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296650
    m_Localized: Recogiste el desatascador
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296651
    m_Localized: Recogiste el destornillador
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296652
    m_Localized: Hay algo adentro
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296653
    m_Localized: Recogiste la llave inglesa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296654
    m_Localized: "Est\xE1 completamente atascado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296655
    m_Localized: El agua ya se fue.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296656
    m_Localized: Le falta la barra para girarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296657
    m_Localized: Usa la barra en el tornillo de banco.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296658
    m_Localized: Usa el martillo en la barra.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296659
    m_Localized: "Peg\xF3 el chicle en el hueso."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296660
    m_Localized: Sigue resbalando, necesito pegar algo al hueso
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296661
    m_Localized: "El destornillador se rompi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296662
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296663
    m_Localized: "CONSEJO: Explora con cuidado, podr\xEDas encontrar pistas importantes."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296664
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296665
    m_Localized: "CONSEJO: Tu linterna tiene bater\xEDa limitada, \xFAsala con cuidado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296666
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296667
    m_Localized: "CONSEJO: Correr puede llamar la atenci\xF3n de los enemigos."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296668
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296669
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296670
    m_Localized: "No hay nada aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296671
    m_Localized: "Tu inventario est\xE1 lleno."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296672
    m_Localized: La reja sigue atornillada.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296673
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296674
    m_Localized: "S\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296675
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296676
    m_Localized: "\xBFSeguro que quieres salir?\n\nSe perder\xE1 el progreso no guardado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296677
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296678
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296679
    m_Localized: "\xBFSeguro que quieres volver al men\xFA principal?\n\nSe perder\xE1
      el progreso no guardado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296680
    m_Localized: "Men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296681
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296682
    m_Localized: "Creo que hab\xEDa algo dentro de ese jarr\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296683
    m_Localized: "Se solt\xF3 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296684
    m_Localized: Activado
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296685
    m_Localized: Desactivado
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296686
    m_Localized: Pantalla completa
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296687
    m_Localized: Ventana
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296688
    m_Localized: Con bordes
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296689
    m_Localized: Pantalla completa exclusiva
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296690
    m_Localized: Muy bajo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296691
    m_Localized: Bajo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296692
    m_Localized: Medio
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296693
    m_Localized: Alto
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296694
    m_Localized: Muy alto
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296695
    m_Localized: Ultra
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296696
    m_Localized: Usar objeto
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296697
    m_Localized: Soltar
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296698
    m_Localized: No hay nada a tu alcance.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296699
    m_Localized: "El inodoro est\xE1 atascado, no encuentro el desatascador. Estaba
      en alg\xFAn lugar dentro de un cubo, pero no recuerdo d\xF3nde."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296701
    m_Localized: Recogiste el embrague
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296700
    m_Localized: "Recogiste la buj\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296702
    m_Localized: E
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296703
    m_Localized: G
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296704
    m_Localized: "Creo que necesito golpearlo con algo para girarlo, est\xE1 completamente
      oxidado"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296705
    m_Localized: "El candado parece f\xE1cil de romper."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296706
    m_Localized: Agacharse
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296707
    m_Localized: Correr
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296708
    m_Localized: Ctrl
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296709
    m_Localized: Shift
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296710
    m_Localized: Estoy bloqueando el paso.
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296711
    m_Localized: "\xBFC\xF3mo calificar\xEDas esta experiencia?"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296712
    m_Localized: "Tensi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296713
    m_Localized: Horror
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296714
    m_Localized: "Diversi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296715
    m_Localized: "*opcional* \xE1rea de comentarios"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296716
    m_Localized: Enviar
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296717
    m_Localized: "Hola \u2014 Queremos aumentar el presupuesto y el alcance del juego
      completo, y tus comentarios son la gu\xEDa m\xE1s importante para seguir adelante."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296718
    m_Localized: '?'
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296719
    m_Localized: Enviando...
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296720
    m_Localized: Enviado
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296721
    m_Localized: Reintentar
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296722
    m_Localized: Califica todo
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296723
    m_Localized: "Configuraci\xF3n necesaria"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296724
    m_Localized: "\xA1Agregar a la lista de deseos!"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296725
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296726
    m_Localized: Ya lo hice
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296727
    m_Localized: Actualizado
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296728
    m_Localized: "El asesino reconocer\xE1 tus movimientos repetidos y se adaptar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296729
    m_Localized: "Lo logr\xE9, timing perfecto"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296730
    m_Localized: Puedo sincronizar el martillazo con el trueno
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296731
    m_Localized: "Esto har\xE1 mucho ruido, no puedo pegarle ahora"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296732
    m_Localized: "Lo golpeé demasiado tarde, me atrapará"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296733
    m_Localized: "Empuja el destornillador."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296734
    m_Localized: "Agita con fuerza para romper la cerradura."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296735
    m_Localized: "Lo golpeé demasiado pronto, me atraparán"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296736
    m_Localized: "Lo golpeé demasiado tarde, me atraparán"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296737
    m_Localized: "Se atascó, inténtalo de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296738
    m_Localized: "Butcher te vio esconderte."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296739
    m_Localized: "Hiciste demasiado ruido."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296740
    m_Localized: "Seguiste escondiéndote en el mismo lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296741
    m_Localized: "No enmascaraste el ruido del martillo con el trueno."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296742
    m_Localized: "Butcher te vio."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296743
    m_Localized: "Te atraparon."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296744
    m_Localized: "Reiniciar"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296745
    m_Localized: "Menú principal"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296746
    m_Localized: "Butcher te emboscó."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296747
    m_Localized: "Las ganzúas te permiten conservar el progreso tras ser atrapado."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296748
    m_Localized: "Ganzúa"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296749
    m_Localized: "Recogiste la ganzúa"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296750
    m_Localized: "Continuar"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296751
    m_Localized: "Mant\u00E9n clic derecho para aplicar presi\u00F3n"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296752
    m_Localized: "Usa el rat\u00F3n para mover la ganz\u00FAa y clic izquierdo para levantar los pines"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296753
    m_Localized: "Perno fijado"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296754
    m_Localized: "Llave abierta"
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296755
    m_Localized: "La puerta está encadenada."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296756
    m_Localized: "Cuando me atraparon la primera vez, encadenó la puerta con un candado. Ojalá hubiera tomado esa horquilla encima de ese inodoro. Tal vez podría haberla usado como ganzúa."
    m_Metadata:
      m_Items: []
  - m_Id: 5707318296757
    m_Localized: "Debo estar atento para encontrar más ganzúas"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
